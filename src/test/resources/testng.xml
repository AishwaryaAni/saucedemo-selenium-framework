<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Full regression. Methods run in parallel — safe because DriverFactory uses ThreadLocal. -->
<suite name="SauceDemo Regression" parallel="methods" thread-count="3" data-provider-thread-count="2">
    <test name="Regression">
        <groups>
            <run>
                <include name="regression"/>
            </run>
        </groups>
        <classes>
            <class name="com.qa.framework.tests.LoginTest"/>
            <class name="com.qa.framework.tests.CheckoutTest"/>
        </classes>
    </test>
</suite>
